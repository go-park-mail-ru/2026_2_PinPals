# PostgreSQL
POSTGRES_USER=GigAdmin
POSTGRES_PASSWORD=Insert_Your_Password
POSTGRES_DB=PicKing
POSTGRES_PORT=8003
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_SSLMODE=disable

# Приложение
APP_PORT=8000
APP_ENV=production
LOG_LEVEL=info

# Директория с изображениями внутри контейнера
IMAGE_DIR=/app/images

# Auth
AUTH_JWT_SECRET=Paste_Your_JWT_Secret_Here
AUTH_TOKEN_TTL=24h

# CORS: список origin через запятую
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
