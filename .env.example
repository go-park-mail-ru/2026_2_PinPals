# PostgreSQL
POSTGRES_USER=GigAdmin
POSTGRES_PASSWORD=Insert_Your_Password
POSTGRES_DB=PicKing
POSTGRES_PORT=8003

# MinIO
MINIO_ROOT_USER=MiniAdmin
MINIO_ROOT_PASSWORD=Insert_Your_Password
MINIO_BUCKET=pins
MINIO_API_PORT=8001
MINIO_CONSOLE_PORT=8002

# Приложение
APP_PORT=8005
APP_ENV=production
LOG_LEVEL=info

# Подключение к PostgreSQL внутри docker-compose
DATABASE_URL=postgres://GigAdmin:Insert_Your_Password@postgres:5432/PicKing?sslmode=disable

# Auth
AUTH_JWT_SECRET=Paste_Your_JWT_Secret_Here
AUTH_TOKEN_TTL=24h

# CORS: список origin через запятую
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MinIO
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=MiniAdmin
S3_SECRET_KEY=Insert_Your_Password
S3_BUCKET=pins
S3_USE_SSL=false
