{
 "uid": "pinpals-db", "title": "PinPals: БД и продуктовые метрики", "schemaVersion": 39, "version": 1, "refresh": "30s",
 "time": {"from": "now-1h", "to": "now"}, "timezone": "browser", "tags": ["pinpals"],
 "panels": [
  {"id":1,"title":"Соединения по сервисам","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum by (app) (pinpals_activity_connections)","legendFormat":"{{app}}"},{"refId":"B","expr":"pg_settings_max_connections","legendFormat":"max_connections"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":2,"title":"Транзакции в секунду","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"refId":"A","expr":"rate(pg_stat_database_xact_commit{datname=\"pinpals\"}[1m])","legendFormat":"commit/s"},{"refId":"B","expr":"rate(pg_stat_database_xact_rollback{datname=\"pinpals\"}[1m])","legendFormat":"rollback/s"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":3,"title":"Cache hit ratio","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"rate(pg_stat_database_blks_hit{datname=\"pinpals\"}[5m]) / clamp_min(rate(pg_stat_database_blks_hit{datname=\"pinpals\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"pinpals\"}[5m]), 1)","legendFormat":"hit ratio"}],"fieldConfig":{"defaults":{"unit":"percentunit"},"overrides":[]}},
  {"id":4,"title":"Сессии в ожидании блокировки / дедлоки за 5 мин","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_lock_waits_waiting","legendFormat":"ждут блокировку"},{"refId":"B","expr":"increase(pg_stat_database_deadlocks{datname=\"pinpals\"}[5m])","legendFormat":"дедлоки"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":5,"title":"Самая долгая открытая транзакция","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":16,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_long_tx_seconds","legendFormat":"сек"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
  {"id":6,"title":"Размер БД","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":16,"w":12,"h":8},"targets":[{"refId":"A","expr":"pg_database_size_bytes{datname=\"pinpals\"}","legendFormat":"размер"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
  {"id":7,"title":"Мёртвые строки по таблицам","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":24,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_table_n_dead_tup","legendFormat":"{{table_name}}"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":8,"title":"Seq scan vs Index scan (в секунду)","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":24,"w":12,"h":8},"targets":[{"refId":"A","expr":"sum(rate(pinpals_table_seq_scan[5m]))","legendFormat":"seq_scan/s"},{"refId":"B","expr":"sum(rate(pinpals_table_idx_scan[5m]))","legendFormat":"idx_scan/s"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":9,"title":"Топ запросов: среднее время, мс","type":"bargauge","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":32,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_slow_statements_mean_exec_time","legendFormat":"{{query}}"}],"fieldConfig":{"defaults":{"unit":"ms"},"overrides":[]}},
  {"id":10,"title":"Размер таблиц","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":32,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_table_total_bytes","legendFormat":"{{table_name}}"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
  {"id":11,"title":"Активные пользователи","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":40,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_product_active_users_day","legendFormat":"за 24 ч"},{"refId":"B","expr":"pinpals_product_active_users_week","legendFormat":"за 7 дней"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":12,"title":"Среднее время сессии (7 дней)","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":40,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_product_avg_session_seconds_week","legendFormat":"сек"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
  {"id":13,"title":"Новое за 24 часа: пины, лайки, комментарии","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":48,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_product_new_pins_day","legendFormat":"пины"},{"refId":"B","expr":"pinpals_product_new_likes_day","legendFormat":"лайки"},{"refId":"C","expr":"pinpals_product_new_comments_day","legendFormat":"комментарии"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":14,"title":"Сохранения, подписки, сообщения за 24 часа","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":48,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_product_pin_saves_day","legendFormat":"сохранения на доски"},{"refId":"B","expr":"pinpals_product_new_subscriptions_day","legendFormat":"подписки"},{"refId":"C","expr":"pinpals_product_chat_messages_day","legendFormat":"сообщения"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":15,"title":"Отзывы и жалобы за 24 часа","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":56,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_product_new_feedback_day","legendFormat":"всего"},{"refId":"B","expr":"pinpals_product_new_complaints_day","legendFormat":"из них жалобы"}],"fieldConfig":{"defaults":{},"overrides":[]}},
  {"id":16,"title":"В среднем на пин","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":56,"w":12,"h":8},"targets":[{"refId":"A","expr":"pinpals_product_avg_likes_per_pin","legendFormat":"лайков"},{"refId":"B","expr":"pinpals_product_avg_comments_per_pin","legendFormat":"комментариев"}],"fieldConfig":{"defaults":{},"overrides":[]}}
 ]
}
